{
	"name": "pidgin",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @pidgin/db db:push",
		"db:studio": "turbo -F @pidgin/db db:studio",
		"db:generate": "turbo -F @pidgin/db db:generate",
		"db:migrate": "turbo -F @pidgin/db db:migrate",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@pidgin/env": "workspace:*",
		"dotenv": "^17.4.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@pidgin/config": "workspace:*",
		"@types/node": "^22.20.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"turbo": "^2.11.10",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "pnpm@11.23.0"
}
