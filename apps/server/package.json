{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@pidgin/db": "workspace:*",
		"@pidgin/env": "workspace:*",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.3.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@pidgin/config": "workspace:*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"tsdown": "^0.16.8",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
